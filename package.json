{
  "name": "sip-website",
  "version": "0.1.0",
  "private": true,
  "description": "Marketing website for SIP Protocol - sip-protocol.org",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:chromium": "playwright test --project=chromium"
  },
  "dependencies": {
    "@sip-protocol/sdk": "^0.1.8",
    "@sip-protocol/types": "^0.1.1",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.400.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@ledgerhq/hw-app-eth": "^6.47.1",
    "@ledgerhq/hw-app-solana": "^7.6.0",
    "@ledgerhq/hw-transport-webhid": "^6.30.9",
    "@ledgerhq/hw-transport-webusb": "^6.29.13",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@trezor/connect-web": "^9.6.4",
    "@types/node": "^20.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^8",
    "eslint-config-next": "14",
    "jsdom": "^27.2.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.0",
    "vitest": "^4.0.14"
  }
}
