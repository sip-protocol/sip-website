# SIP Website Environment Configuration
# Copy this to .env.local for local development

# Enable real swaps via NEAR 1Click API (default: false = demo mode)
# NEXT_PUBLIC_REAL_SWAPS=true

# Optional: NEAR Intents JWT token for authenticated API access
# Get one at https://near-intents.org
# NEXT_PUBLIC_NEAR_INTENTS_JWT=your-jwt-token-here
